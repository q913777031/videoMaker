 "lines": [
  {
   "id": "hook1",
   "speaker": "n",
   "text": "连续猜中十次硬币的人，教你成功秘诀。",
   "sub": "连续猜中【10次】硬币的人，教你成功秘诀。",
   "start": 0.35,
   "end": 3.343
  },
  {
   "id": "hook2",
   "speaker": "n",
   "text": "你学不学？",
   "sub": "【你学不学？】",
   "start": 3.463,
   "end": 4.307
  },
  {
   "id": "setup1",
   "speaker": "n",
   "text": "让一千零二十四个人猜硬币，",
   "sub": "让【1024】个人猜硬币，",
   "start": 5.257,
   "end": 7.409
  },
  {
   "id": "setup2",
   "speaker": "n",
   "text": "猜错退出，猜对继续。",
   "sub": "猜错【退出】，猜对【继续】。",
   "start": 7.529,
   "end": 9.447
  },
  {
   "id": "round1",
   "speaker": "n",
   "text": "为了看清过程，我们按每轮一半晋级来演示。",
   "sub": "为了看清过程，我们按【每轮一半晋级】来演示。",
   "start": 10.197,
   "end": 13.598
  },
  {
   "id": "round2",
   "speaker": "n",
   "text": "十轮以后，剩下一位十连胜冠军。",
   "sub": "十轮以后，剩下一位【十连胜冠军】。",
   "start": 20.447,
   "end": 23.263
  },
  {
   "id": "guru1",
   "speaker": "c",
   "text": "我的秘诀？",
   "sub": "我的秘诀？",
   "start": 25.213,
   "end": 26.026
  },
  {
   "id": "guru2",
   "speaker": "c",
   "text": "相信自己，",
   "sub": "【相信自己】，",
   "start": 26.326,
   "end": 27.319
  },
  {
   "id": "guru3",
   "speaker": "c",
   "text": "坚持判断，",
   "sub": "【坚持判断】，",
   "start": 27.619,
   "end": 28.543
  },
  {
   "id": "guru4",
   "speaker": "c",
   "text": "还有，",
   "sub": "还有——",
   "start": 28.893,
   "end": 29.213
  },
  {
   "id": "guru5",
   "speaker": "c",
   "text": "保持手感。",
   "sub": "【保持手感】。",
   "start": 29.563,
   "end": 30.383
  },
  {
   "id": "freeze1",
   "speaker": "n",
   "text": "听起来有道理？",
   "sub": "听起来有道理？",
   "start": 31.983,
   "end": 33.203
  },
  {
   "id": "freeze2",
   "speaker": "n",
   "text": "等等，其他人去哪了？",
   "sub": "等等，【其他人】去哪了？",
   "start": 33.603,
   "end": 35.436
  },
  {
   "id": "reveal1",
   "speaker": "n",
   "text": "镜头外，还有一千零二十三个人。",
   "sub": "镜头外，还有【1023】个人。",
   "start": 36.536,
   "end": 39.217
  },
  {
   "id": "reveal2",
   "speaker": "n",
   "text": "刚才，我们只盯着赢家，",
   "sub": "刚才，我们只盯着【赢家】，",
   "start": 39.617,
   "end": 41.702
  },
  {
   "id": "reveal3",
   "speaker": "n",
   "text": "却没问输家是不是也相信自己、坚持判断。",
   "sub": "却没问【输家】是不是也相信自己、坚持判断。",
   "start": 41.802,
   "end": 45.406
  },
  {
   "id": "name1",
   "speaker": "n",
   "text": "这叫幸存者偏差。",
   "sub": "这叫【幸存者偏差】。",
   "start": 46.606,
   "end": 48.439
  },
  {
   "id": "name2",
   "speaker": "n",
   "text": "只看留下来的样本，就可能误判全貌。",
   "sub": "只看【留下来】的样本，就可能误判全貌。",
   "start": 48.739,
   "end": 51.947
  },
  {
   "id": "name3",
   "speaker": "n",
   "text": "学习经验分享，也要问问没成功的人。",
   "sub": "学习经验分享，也要问问【没成功的人】。",
   "start": 52.297,
   "end": 55.457
  },
  {
   "id": "outro1",
   "speaker": "n",
   "text": "经验可以参考，",
   "sub": "经验【可以参考】，",
   "start": 56.257,
   "end": 57.579
  },
  {
   "id": "outro2",
   "speaker": "n",
   "text": "但别只问赢家做了什么。",
   "sub": "但别只问赢家做了什么。",
   "start": 57.729,
   "end": 59.877
  },
  {
   "id": "outro3",
   "speaker": "n",
   "text": "还要问：",
   "sub": "还要问：",
   "start": 60.177,
   "end": 60.752
  },
  {
   "id": "outro4",
   "speaker": "n",
   "text": "做了同样的事，却没成功的人呢？",
   "sub": "做了同样的事，【却没成功的人呢？】",
   "start": 60.952,
   "end": 63.626
  }
 ],
