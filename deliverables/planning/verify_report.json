 "reading": [
  {
   "shot": 1,
   "text": "说好周五交，／怎么又拖到下周？",
   "han": 12,
   "start": 0.2,
   "end": 5.533333333333333,
   "window": 5.333333333333333,
   "budget": 2.6666666666666665,
   "need": 3.0,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 2,
   "text": "开工时，／明明觉得时间够用。",
   "han": 11,
   "start": 6.333333333333334,
   "end": 11.4,
   "window": 5.066666666666666,
   "budget": 2.4444444444444446,
   "need": 3.0,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 3,
   "text": "做着做着，／意外一件接一件。",
   "han": 11,
   "start": 12.200000000000001,
   "end": 16.700000000000003,
   "window": 4.500000000000002,
   "budget": 2.4444444444444446,
   "need": 3.0,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 4,
   "text": "估算时，／脑子里只有顺利剧本。",
   "han": 12,
   "start": 17.5,
   "end": 23.6,
   "window": 6.100000000000001,
   "budget": 2.6666666666666665,
   "need": 3.0,
   "ok": true,
   "tag": "机制示意"
  },
  {
   "shot": 5,
   "text": "上次类似的事，／你花了多久？",
   "han": 11,
   "start": 24.4,
   "end": 29.46666666666667,
   "window": 5.06666666666667,
   "budget": 2.4444444444444446,
   "need": 3.0,
   "ok": true,
   "tag": "反思练习"
  },
  {
   "shot": 6,
   "text": "1994年研究：／常把用时估得太短。",
   "han": 11,
   "start": 30.266666666666666,
   "end": 35.833333333333336,
   "window": 5.56666666666667,
   "budget": 2.4444444444444446,
   "need": 4.2444444444444445,
   "ok": true,
   "tag": "研究示意"
  },
  {
   "shot": 7,
   "text": "学业和非学业任务，／都出现这种偏差。",
   "han": 15,
   "start": 36.63333333333333,
   "end": 41.66666666666667,
   "window": 5.0333333333333385,
   "budget": 3.3333333333333335,
   "need": 4.333333333333334,
   "ok": true,
   "tag": "研究示意"
  },
  {
   "shot": 8,
   "text": "这叫计划谬误：／总按理想剧本估时间。",
   "han": 15,
   "start": 42.46666666666667,
   "end": 47.53333333333333,
   "window": 5.066666666666663,
   "budget": 3.3333333333333335,
   "need": 4.333333333333334,
   "ok": true,
   "tag": "机制示意"
  },
  {
   "shot": 9,
   "text": "预测时多想未来，／很少翻看过去的经验。",
   "han": 16,
   "start": 48.33333333333333,
   "end": 53.9,
   "window": 5.56666666666667,
   "budget": 3.5555555555555554,
   "need": 4.555555555555555,
   "ok": true,
   "tag": "机制示意"
  },
  {
   "shot": 10,
   "text": "对照过往经验后，／这种乐观偏差消失了。",
   "han": 16,
   "start": 54.699999999999996,
   "end": 59.733333333333334,
   "window": 5.0333333333333385,
   "budget": 3.5555555555555554,
   "need": 4.555555555555555,
   "ok": true,
   "tag": "研究示意"
  },
  {
   "shot": 11,
   "text": "下次估时间前，／先翻翻上次的记录。",
   "han": 14,
   "start": 60.53333333333333,
   "end": 65.6,
   "window": 5.066666666666663,
   "budget": 3.111111111111111,
   "need": 3.111111111111111,
   "ok": true,
   "tag": "反思练习"
  },
  {
   "shot": 12,
   "text": "再给意外，／留一段空白。",
   "han": 9,
   "start": 66.4,
   "end": 71.96666666666665,
   "window": 5.566666666666649,
   "budget": 2.0,
   "need": 3.0,
   "ok": true,
   "tag": "反思练习"
  },
  {
   "shot": 13,
   "text": "长期被截止日压垮，／也值得和人一起商量。",
   "han": 17,
   "start": 72.76666666666667,
   "end": 77.3,
   "window": 4.533333333333331,
   "budget": 3.7777777777777777,
   "need": 3.7777777777777777,
   "ok": true,
   "tag": "生活提示"
  },
  {
   "shot": 14,
   "text": "拖了不等于你不行，／可能只是估得太乐观。",
   "han": 17,
   "start": 78.10000000000001,
   "end": 83.66666666666666,
   "window": 5.566666666666649,
   "budget": 3.7777777777777777,
   "need": 3.7777777777777777,
   "ok": true,
   "tag": "情境演绎"
  },
