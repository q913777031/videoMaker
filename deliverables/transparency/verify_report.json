 "reading": [
  {
   "shot": 1,
   "text": "面试时心跳很快，／是不是全写在脸上？",
   "han": 15,
   "start": 0.2,
   "end": 5.533333333333333,
   "window": 5.333333333333333,
   "budget": 3.3333333333333335,
   "need": 3.3333333333333335,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 2,
   "text": "手心出汗，／声音好像也在发抖。",
   "han": 12,
   "start": 6.333333333333334,
   "end": 11.4,
   "window": 5.066666666666666,
   "budget": 2.6666666666666665,
   "need": 3.0,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 3,
   "text": "你觉得自己，／像一块透明玻璃。",
   "han": 12,
   "start": 12.200000000000001,
   "end": 16.700000000000003,
   "window": 4.500000000000002,
   "budget": 2.6666666666666665,
   "need": 3.0,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 4,
   "text": "内心越吵，／越觉得别人都听得到。",
   "han": 13,
   "start": 17.5,
   "end": 23.6,
   "window": 6.100000000000001,
   "budget": 2.888888888888889,
   "need": 3.0,
   "ok": true,
   "tag": "机制示意"
  },
  {
   "shot": 5,
   "text": "对面的人，／真的看到了多少？",
   "han": 11,
   "start": 24.4,
   "end": 29.46666666666667,
   "window": 5.06666666666667,
   "budget": 2.4444444444444446,
   "need": 3.0,
   "ok": true,
   "tag": "反思练习"
  },
  {
   "shot": 6,
   "text": "1998年研究：／提出透明度错觉。",
   "han": 10,
   "start": 30.266666666666666,
   "end": 35.833333333333336,
   "window": 5.56666666666667,
   "budget": 2.2222222222222223,
   "need": 4.022222222222222,
   "ok": true,
   "tag": "研究示意"
  },
  {
   "shot": 7,
   "text": "人们常高估：／自己的内心有多明显。",
   "han": 14,
   "start": 36.63333333333333,
   "end": 41.66666666666667,
   "window": 5.0333333333333385,
   "budget": 3.111111111111111,
   "need": 4.111111111111111,
   "ok": true,
   "tag": "研究示意"
  },
  {
   "shot": 8,
   "text": "这叫透明度错觉：／以为心事都写在脸上。",
   "han": 16,
   "start": 42.46666666666667,
   "end": 47.53333333333333,
   "window": 5.066666666666663,
   "budget": 3.5555555555555554,
   "need": 4.555555555555555,
   "ok": true,
   "tag": "机制示意"
  },
  {
   "shot": 9,
   "text": "你感到的是全部，／别人看到的是表面。",
   "han": 15,
   "start": 48.33333333333333,
   "end": 53.9,
   "window": 5.56666666666667,
   "budget": 3.3333333333333335,
   "need": 3.3333333333333335,
   "ok": true,
   "tag": "机制示意"
  },
  {
   "shot": 10,
   "text": "在对面看来，／你只是有点认真。",
   "han": 12,
   "start": 54.699999999999996,
   "end": 59.233333333333334,
   "window": 4.5333333333333385,
   "budget": 2.6666666666666665,
   "need": 3.0,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 11,
   "text": "先问自己：／对方能看到什么证据？",
   "han": 13,
   "start": 60.03333333333333,
   "end": 65.6,
   "window": 5.566666666666663,
   "budget": 2.888888888888889,
   "need": 3.0,
   "ok": true,
   "tag": "反思练习"
  },
  {
   "shot": 12,
   "text": "把注意力，／放回要回答的问题上。",
   "han": 13,
   "start": 66.4,
   "end": 71.96666666666665,
   "window": 5.566666666666649,
   "budget": 2.888888888888889,
   "need": 3.0,
   "ok": true,
   "tag": "反思练习"
  },
  {
   "shot": 13,
   "text": "紧张让你总想逃开，／也值得寻求支持。",
   "han": 15,
   "start": 72.76666666666667,
   "end": 77.3,
   "window": 4.533333333333331,
   "budget": 3.3333333333333335,
   "need": 3.3333333333333335,
   "ok": true,
   "tag": "生活提示"
  },
  {
   "shot": 14,
   "text": "心跳是你的，／别人未必看得那么清。",
   "han": 14,
   "start": 78.10000000000001,
   "end": 83.66666666666666,
   "window": 5.566666666666649,
   "budget": 3.111111111111111,
   "need": 3.111111111111111,
   "ok": true,
   "tag": "情境演绎"
  },
  {
   "shot": 15,
   "text": "参考：1998年／《透明度错觉》论文",
   "han": 10,
   "start": 84.46666666666667,
   "end": 89.6,
   "window": 5.133333333333326,
   "budget": 2.2222222222222223,
